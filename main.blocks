ekind" id="DAPPqG/{+4i=Z2EB{0f1"><field name="MEMBER">Enemy</field></shadow></value></block></value><next><block type="pxt_controls_for" id="uIbh/NC}_Q?azX`BPQRl"><value name="VAR"><block type="variables_get_reporter" id="-mpXpEJ1DEsKn_-yAwmA"><mutation duplicateondrag="true"></mutation><field name="VAR" id="z=1_t.aT*hE_K8)t9G`Q">i</field></block></value><value name="TO"><shadow type="math_whole_number" id="}Sb}*4zersaFiM$f4@Kc"><field name="NUM">0</field></shadow><block type="math_arithmetic" id="TLhnq-~mGv?%3{u#wldl"><field name="OP">MINUS</field><value name="A"><shadow type="math_number" id="n#*{j]p~+h51`2*pL$4N"><field name="NUM">0</field></shadow><block type="lists_length" id="+9iF#cPo%X/n/{Wf;Uf*"><value name="VALUE"><block type="variables_get" id="-3bQ?JH8),^*;WekF;Bk"><field name="VAR" id=",St*)Mg^Ss]M-U~OoeWD">enemies</field></block></value></block></value><value name="B"><shadow type="math_number" id="YJarlX]EUag6oRJh^xJa"><field name="NUM">1</field></shadow></value></block></value><statement name="DO"><block type="typescript_statement" id="Zh1_I95uuT}TYmK/Z5l,"><mutation xmlns="http://www.w3.org/1999/xhtml" line0="for (let j = i + 1; j &lt; enemies.length; j++) {" line1="            let enemyA = enemies[i]" line2="            let enemyB = enemies[j]" line3="" line4="            let distance = spriteutils.distanceBetween(enemyA, enemyB)" line5="" line6="            if (distance &lt; REPEL_DISTANCE &amp;&amp; distance &gt; 0) {" line7="                let angleAtoB = spriteutils.angleFrom(enemyA, enemyB)" line8="                let overlap = REPEL_DISTANCE - distance" line9="" line10="                // Position Correction" line11="                let angleA_rad = (angleAtoB + 180) * (Math.PI / 180)" line12="                let angleB_rad = angleAtoB * (Math.PI / 180)" line13="" line14="                // Move A instantly by half the overlap to push it out" line15="                enemyA.x += overlap / 2 * Math.cos(angleA_rad)" line16="                enemyA.y += overlap / 2 * Math.sin(angleA_rad)" line17="" line18="                // Move B instantly by the other half" line19="                enemyB.x += overlap / 2 * Math.cos(angleB_rad)" line20="                enemyB.y += overlap / 2 * Math.sin(angleB_rad)" line21="" line22="                // Optional: Instant push for momentum" line23="                spriteutils.setVelocityAtAngle(enemyA, angleAtoB + 180, PUSH_SPEED)" line24="                spriteutils.setVelocityAtAngle(enemyB, angleAtoB, PUSH_SPEED)" line25="            }" line26="        }" numlines="27"></mutation></block></statement></block></next></block></statement></block><block type="keyonevent" id="a+Cp36WZn#^jh.]1ZB,R" x="5594" y="-203"><field name="button">controller.A</field><field name="event">ControllerButtonEvent.Pressed</field><statement name="HANDLER"><block type="controls_if" id="Lpu@[~Cc9t^DC@rK@fGs"><mutation else="1"></mutation><value name="IF0"><shadow type="logic_boolean" id="AePVc;3jpfiN^PPE2ond"><field name="BOOL">TRUE</field></shadow><block type="logic_negate" id="1)/2Lrgg4,7[v+Wme%YN"><value name="BOOL"><shadow type="logic_boolean" id="s%gd0H%S8N}E3V~@ot(y"><field name="BOOL">TRUE</field></shadow><block type="variables_get" id="^,%~J*7|?%dX^ZE`|b|]"><field name="VAR" id="u.,k*ar^2McHz?(E#R:L">isInMenu</field></block></value></block></value><statement name="DO0"><block type="controls_if" id="+A5A,h/~o@aR6Y7]d;ZH"><mutation else="1"></mutation><value name="IF0"><shadow type="logic_boolean" id="?:4Obe^c}8x8C,Dfs=mX"><field name="BOOL">TRUE</field></shadow><block type="arcade_character_is_facing" id="y3;^pwCH{X2O%H[QOUae"><value name="sprite"><block type="variables_get" id="CTrzvQF+3OE|f4qQwzL{"><field name="VAR" id="{.l[gW;Uyk_EZ)*G][Bw">PlayerSprite</field></block></value><value name="rule"><shadow type="arcade_character_make_rule" id="#L`I4[D;;-6E|2]6uGfH"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="0" _input_init="true"></mutation><value name="p1"><shadow type="arcade_